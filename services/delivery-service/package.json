{
  "name": "delivery-service",
  "version": "1.0.0",
  "private": true,
  "description": "Сервис транзакционных уведомлений с поддержкой каналов Bitrix24 и Email. Потребляет уведомления из очереди, реализует гибкую доставку через систему стратегий и поддерживает легкое масштабирование новыми каналами и стратегиями отправки.",
  "license": "MIT",
  "author": {
    "name": "Andrey Antropov",
    "email": "andreyantropov.1994@gmail.com"
  },
  "contributors": [
    {
      "name": "Andrey Antropov",
      "email": "andrey.antropov@planarchel.ru"
    }
  ],
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=9.0.0"
  },
  "main": "index.js",
  "scripts": {
    "dev": "tsx --watch --env-file=.env.dev --import ./src/instrumentation.ts src/index.ts",
    "build": "tsup src/index.ts src/instrumentation.ts --format esm --splitting --sourcemap --clean --minify --treeshake",
    "start": "node --import ./dist/instrumentation.js ./dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:format": "prettier . --write",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudamqp/amqp-client": "^3.3.2",
    "@notification-platform/core": "workspace:*",
    "@notification-platform/http": "workspace:*",
    "@notification-platform/amqp": "workspace:*",
    "@notification-platform/telemetry": "workspace:*",
    "awilix": "^12.0.5",
    "axios": "^1.9.0",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "nodemailer": "^7.0.3",
    "p-limit": "^7.3.0",
    "zod": "^3.25.41"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^6.4.17"
  }
}
